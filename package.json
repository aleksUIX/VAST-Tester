{
  "name": "vast-tester-aleksuix",
  "version": "0.1.0",
  "description": "Modern VAST tester built on top of published vastlint packages.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cf:login": "npx wrangler login",
    "cf:pages:create": "npx wrangler pages project create iab-tech-lab-vast-tester --production-branch=main",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name=iab-tech-lab-vast-tester --branch=main",
    "preview": "vite preview",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "playwright test --project=smoke"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vastlint": "0.13.8",
    "vastlint-client": "0.13.8",
    "vastlint-react": "0.13.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
