{
  "name": "vast-tester",
  "version": "0.1.0",
  "description": "IAB Tech Lab VAST Tester.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test --project=smoke",
    "test:e2e:subpath": "PLAYWRIGHT_BASE_PATH=/VAST-Tester/ playwright test --project=smoke --grep \"VAST tester smoke|SIMID|share link|artifact bundle\""
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vastlint": "0.15.0",
    "vastlint-client": "0.15.0",
    "vastlint-react": "0.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "@types/node": "^22.16.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
